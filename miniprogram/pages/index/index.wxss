/* pages/index/index.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f5ff 0%, #ffffff 300rpx);
  padding: 30rpx;
}

/* 顶部欢迎区域 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 20rpx;
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  border-radius: 20rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(24, 144, 255, 0.3);
}

.welcome-text {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.header-decoration {
  font-size: 80rpx;
}

/* 功能卡片 */
.feature-cards {
  margin-bottom: 40rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s, box-shadow 0.2s;
  position: relative;
  z-index: 1;
}

.feature-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.card-icon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.card-icon .icon {
  font-size: 48rpx;
}

.card-content {
  flex: 1;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.card-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
}

.card-arrow {
  font-size: 48rpx;
  color: #ccc;
}

/* 快捷功能区 */
.quick-actions {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}

.action-grid {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  width: 160rpx;
  flex-shrink: 0;
}

.action-item:active {
  background: #f5f5f5;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-text {
  font-size: 24rpx;
  color: #666;
}

/* 面试小贴士 */
.tips-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tips-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.tips-swiper {
  height: 100rpx;
}

.tip-content {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  background: #f0f5ff;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.tip-content text {
  font-size: 28rpx;
  color: #666;
  text-align: center;
}
