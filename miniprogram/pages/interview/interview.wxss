/* pages/interview/interview.wxss */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
}

/* 进度头部 */
.progress-header {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.progress-count {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: bold;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1890ff 0%, #40a9ff 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-time {
  display: flex;
  align-items: center;
  justify-content: center;
}

.time-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.time-text {
  font-size: 28rpx;
  color: #666;
  font-family: 'Courier New', monospace;
}

/* 题目卡片 */
.question-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.question-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.tag-type {
  background: #e6f7ff;
  color: #1890ff;
}

.tag-level {
  background: #f5f5f5;
}

.level-easy {
  color: #52c41a;
}

.level-middle {
  color: #faad14;
}

.level-high {
  color: #f5222d;
}

.tag-source {
  background: #fff7e6;
  color: #fa8c16;
}

.question-content {
  margin-bottom: 20rpx;
}

.question-number {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 16rpx;
}

.question-text {
  display: block;
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
}

.question-hint {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f0f5ff;
  border-radius: 12rpx;
}

.hint-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #666;
}

/* 回答区域 */
.answer-section {
  margin-bottom: 30rpx;
}

.answer-input-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.answer-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  box-sizing: border-box;
  background: #fafafa;
}

.answer-textarea:focus {
  border-color: #1890ff;
  background: #ffffff;
}

.answer-char-count {
  text-align: right;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

/* 代码编辑器 */
.code-editor {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.editor-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.editor-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.editor-hint {
  font-size: 24rpx;
  color: #999;
}

.code-textarea {
  width: 100%;
  height: 300rpx;
  padding: 24rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-family: 'Courier New', monospace;
  line-height: 1.6;
  color: #333;
  box-sizing: border-box;
  background: #f8f8f8;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.btn {
  flex: 1;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 45rpx;
  font-size: 30rpx;
  transition: all 0.2s;
}

.btn-default {
  background: #ffffff;
  color: #666;
  border: 2rpx solid #e8e8e8;
}

.btn-primary {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(24, 144, 255, 0.3);
}

.btn-prev, .btn-next {
  flex: 0.5;
}

/* 底部功能 */
.bottom-actions {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 40rpx;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-icon.marked {
  color: #faad14;
}

.action-item text:last-child {
  font-size: 24rpx;
  color: #666;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-large {
  max-width: 750rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 50rpx;
  color: #999;
  padding: 0 20rpx;
}

.modal-body {
  margin-bottom: 30rpx;
}

.hint-content, .answer-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
}

.modal-footer .btn {
  flex: 1;
}

/* 完成统计 */
.complete-stats {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 12rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #999;
}
