<!--pages/interview/interview.wxml-->
<view class="container">
  <!-- 顶部进度 -->
  <view class="progress-header">
    <view class="progress-info">
      <text class="progress-title">面试进行中</text>
      <text class="progress-count">{{currentIndex + 1}} / {{totalQuestions}}</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progressPercent}}%"></view>
    </view>
    <view class="progress-time">
      <text class="time-icon">⏱</text>
      <text class="time-text">{{formatTime(elapsedTime)}}</text>
    </view>
  </view>

  <!-- 题目卡片 -->
  <view class="question-card" wx:if="{{currentQuestion}}">
    <!-- 题目类型标签 -->
    <view class="question-tags">
      <text class="tag tag-type">{{currentQuestion.category || '技术'}}</text>
      <text class="tag tag-level level-{{currentQuestion.difficulty}}">
        {{getDifficultyText(currentQuestion.difficulty)}}
      </text>
      <text class="tag tag-source" wx:if="{{currentQuestion.source}}">
        关联: {{currentQuestion.source}}
      </text>
    </view>

    <!-- 题目内容 -->
    <view class="question-content">
      <text class="question-number">Q{{currentIndex + 1}}</text>
      <text class="question-text">{{currentQuestion.question}}</text>
    </view>

    <!-- 题目类型说明 -->
    <view class="question-hint" wx:if="{{currentQuestion.type === 'code'}}">
      <text class="hint-icon">💡</text>
      <text class="hint-text">请在下方输入框中写出你的答案</text>
    </view>
    <view class="question-hint" wx:elif="{{currentQuestion.type === 'design'}}">
      <text class="hint-icon">💡</text>
      <text class="hint-text">请从系统设计角度分析并回答</text>
    </view>
  </view>

  <!-- 回答区域 -->
  <view class="answer-section">
    <!-- 文字回答 -->
    <view class="answer-input-section">
      <textarea 
        class="answer-textarea"
        placeholder="在这里输入你的回答..."
        value="{{userAnswer}}"
        bindinput="onAnswerInput"
        maxlength="2000"
        auto-height
        disabled="{{isSubmitting}}"
      />
      <view class="answer-char-count">
        <text>{{userAnswer.length}}/2000</text>
      </view>
    </view>

    <!-- 代码编辑器（代码题专用） -->
    <view class="code-editor" wx:if="{{currentQuestion.type === 'code'}}">
      <view class="editor-header">
        <text class="editor-title">代码区域</text>
        <text class="editor-hint">支持基本语法高亮</text>
      </view>
      <textarea 
        class="code-textarea"
        placeholder="// 在这里编写代码..."
        value="{{codeAnswer}}"
        bindinput="onCodeInput"
        maxlength="5000"
        disabled="{{isSubmitting}}"
      />
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button 
      class="btn btn-default btn-prev"
      bindtap="prevQuestion"
      disabled="{{currentIndex === 0}}"
    >
      <text>上一题</text>
    </button>
    
    <button 
      class="btn btn-primary btn-submit"
      bindtap="submitAnswer"
      loading="{{isSubmitting}}"
    >
      <text wx:if="{{!isSubmitting}}">{{isLastQuestion ? '完成面试' : '提交并下一题'}}</text>
    </button>
    
    <button 
      class="btn btn-default btn-next"
      bindtap="nextQuestion"
      wx:if="{{!isLastQuestion}}"
    >
      <text>跳过</text>
    </button>
  </view>

  <!-- 底部功能 -->
  <view class="bottom-actions">
    <view class="action-item" bindtap="showHint">
      <text class="action-icon">💡</text>
      <text>提示</text>
    </view>
    <view class="action-item" bindtap="showAnswer">
      <text class="action-icon">📝</text>
      <text>参考答案</text>
    </view>
    <view class="action-item" bindtap="markQuestion">
      <text class="action-icon {{isMarked ? 'marked' : ''}}">⭐</text>
      <text>收藏</text>
    </view>
  </view>
</view>

<!-- 提示弹窗 -->
<view class="modal-overlay" wx:if="{{showHintModal}}" bindtap="closeHintModal">
  <view class="modal-content" catchtap="preventBubble">
    <view class="modal-header">
      <text class="modal-title">💡 题目提示</text>
      <text class="modal-close" bindtap="closeHintModal">×</text>
    </view>
    <view class="modal-body">
      <text class="hint-content">{{hintContent}}</text>
    </view>
    <button class="btn btn-primary btn-block" bindtap="closeHintModal">我知道了</button>
  </view>
</view>

<!-- 参考答案弹窗 -->
<view class="modal-overlay" wx:if="{{showAnswerModal}}" bindtap="closeAnswerModal">
  <view class="modal-content modal-large" catchtap="preventBubble">
    <view class="modal-header">
      <text class="modal-title">📝 参考答案</text>
      <text class="modal-close" bindtap="closeAnswerModal">×</text>
    </view>
    <view class="modal-body">
      <text class="answer-content">{{referenceAnswer}}</text>
    </view>
    <view class="modal-footer">
      <button class="btn btn-default" bindtap="closeAnswerModal">关闭</button>
      <button class="btn btn-primary" bindtap="nextAfterViewAnswer">下一题</button>
    </view>
  </view>
</view>

<!-- 完成弹窗 -->
<view class="modal-overlay" wx:if="{{showCompleteModal}}">
  <view class="modal-content" catchtap="preventBubble">
    <view class="modal-header">
      <text class="modal-title">🎉 面试完成</text>
    </view>
    <view class="modal-body">
      <view class="complete-stats">
        <view class="stat-item">
          <text class="stat-value">{{completedCount}}</text>
          <text class="stat-label">完成题目</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{totalQuestions}}</text>
          <text class="stat-label">总题目数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{formatTime(totalTime)}}</text>
          <text class="stat-label">总用时</text>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <button class="btn btn-default" bindtap="reInterview">再练一次</button>
      <button class="btn btn-primary" bindtap="viewResult">查看报告</button>
    </view>
  </view>
</view>
