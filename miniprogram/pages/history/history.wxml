<!--pages/history/history.wxml-->
<view class="container">
  <!-- 统计概览 -->
  <view class="stats-overview">
    <view class="stat-card">
      <text class="stat-value">{{stats.totalInterviews}}</text>
      <text class="stat-label">面试次数</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.totalQuestions}}</text>
      <text class="stat-label">完成题目</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{stats.totalTime}}</text>
      <text class="stat-label">累计时长</text>
    </view>
  </view>

  <!-- 筛选和搜索 -->
  <view class="filter-section">
    <view class="filter-tabs">
      <view 
        class="tab-item {{currentFilter === 'all' ? 'active' : ''}}"
        bindtap="changeFilter"
        data-filter="all"
      >
        全部
      </view>
      <view 
        class="tab-item {{currentFilter === 'today' ? 'active' : ''}}"
        bindtap="changeFilter"
        data-filter="today"
      >
        今天
      </view>
      <view 
        class="tab-item {{currentFilter === 'week' ? 'active' : ''}}"
        bindtap="changeFilter"
        data-filter="week"
      >
        本周
      </view>
      <view 
        class="tab-item {{currentFilter === 'month' ? 'active' : ''}}"
        bindtap="changeFilter"
        data-filter="month"
      >
        本月
      </view>
    </view>
  </view>

  <!-- 历史列表 -->
  <view class="history-list" wx:if="{{filteredHistory.length > 0}}">
    <view 
      class="history-item"
      wx:for="{{filteredHistory}}"
      wx:key="id"
    >
      <view class="item-header" bindtap="toggleExpand" data-id="{{item.id}}">
        <view class="item-info">
          <text class="item-position">{{item.jdSummary?.position || '面试练习'}}</text>
          <text class="item-date">{{formatDate(item.date)}}</text>
        </view>
        <view class="item-meta">
          <view class="meta-badge">
            <text class="badge-icon">📝</text>
            <text>{{item.completedCount || 0}}/{{item.questions?.length || 0}}</text>
          </view>
          <text class="expand-icon {{expandedId === item.id ? 'expanded' : ''}}">›</text>
        </view>
      </view>

      <!-- 展开详情 -->
      <view class="item-detail {{expandedId === item.id ? 'show' : ''}}">
        <!-- 技能标签 -->
        <view class="skill-tags" wx:if="{{item.jdSummary?.topSkills?.length > 0}}">
          <text class="tag" wx:for="{{item.jdSummary.topSkills}}" wx:key="index">{{item}}</text>
        </view>

        <!-- 摘要信息 -->
        <view class="summary-info">
          <view class="summary-item">
            <text class="summary-label">用时:</text>
            <text class="summary-value">{{formatDuration(item.totalTime)}}</text>
          </view>
          <view class="summary-item">
            <text class="summary-label">难度:</text>
            <text class="summary-value">{{item.jdSummary?.experience?.required || 0}}+年经验</text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="item-actions">
          <button class="action-btn" bindtap="viewDetail" data-id="{{item.id}}">查看详情</button>
          <button class="action-btn" bindtap="rePractice" data-id="{{item.id}}">再练一次</button>
          <button class="action-btn btn-danger" bindtap="deleteItem" data-id="{{item.id}}">删除</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <image src="/assets/images/empty.png" mode="aspectFit" wx:if="{{false}}" />
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无面试记录</text>
    <text class="empty-hint">开始你的第一次模拟面试吧</text>
    <button class="btn btn-primary" bindtap="startInterview">开始面试</button>
  </view>
</view>
