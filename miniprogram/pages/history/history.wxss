/* pages/history/history.wxss */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
}

/* 统计概览 */
.stats-overview {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 30rpx rgba(24, 144, 255, 0.2);
}

.stat-card:nth-child(2) {
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  box-shadow: 0 8rpx 30rpx rgba(82, 196, 26, 0.2);
}

.stat-card:nth-child(3) {
  background: linear-gradient(135deg, #faad14 0%, #ffc53d 100%);
  box-shadow: 0 8rpx 30rpx rgba(250, 173, 20, 0.2);
}

.stat-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 筛选区域 */
.filter-section {
  margin-bottom: 30rpx;
}

.filter-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background: #1890ff;
  color: #ffffff;
}

/* 历史列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.item-info {
  display: flex;
  flex-direction: column;
}

.item-position {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.item-date {
  font-size: 24rpx;
  color: #999;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.meta-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #f0f5ff;
  border-radius: 20rpx;
}

.badge-icon {
  font-size: 24rpx;
}

.meta-badge text:last-child {
  font-size: 24rpx;
  color: #1890ff;
}

.expand-icon {
  font-size: 40rpx;
  color: #ccc;
  transition: transform 0.2s;
}

.expand-icon.expanded {
  transform: rotate(90deg);
}

/* 展开详情 */
.item-detail {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.item-detail.show {
  max-height: 500rpx;
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 0 30rpx 20rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background: #e6f7ff;
  color: #1890ff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.summary-info {
  display: flex;
  gap: 40rpx;
  padding: 0 30rpx 20rpx;
}

.summary-item {
  display: flex;
  align-items: center;
}

.summary-label {
  font-size: 26rpx;
  color: #999;
  margin-right: 8rpx;
}

.summary-value {
  font-size: 26rpx;
  color: #333;
}

.item-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 35rpx;
  font-size: 26rpx;
  color: #666;
}

.action-btn.btn-danger {
  background: #fff1f0;
  color: #ff4d4f;
}

.btn-primary {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: #ffffff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}
