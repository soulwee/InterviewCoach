/* pages/jd-input/jd-input.wxss */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
}

/* 页面标题 */
.page-header {
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.page-desc {
  font-size: 28rpx;
  color: #999;
  display: block;
}

/* 输入区域 */
.input-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.input-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.input-label text:last-child {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.jd-textarea {
  width: 100%;
  min-height: 350rpx;
  padding: 24rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  box-sizing: border-box;
  background: #fafafa;
}

.jd-textarea:focus {
  border-color: #1890ff;
  background: #ffffff;
}

.char-count {
  text-align: right;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

/* 模板区域 */
.template-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-hint {
  font-size: 24rpx;
  color: #999;
}

.template-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.template-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.template-item.active {
  background: #e6f7ff;
  border-color: #1890ff;
}

.template-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.template-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 设置区域 */
.settings-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  display: flex;
  align-items: center;
}

.setting-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.setting-label text:last-child {
  font-size: 28rpx;
  color: #333;
}

.setting-control {
  display: flex;
  align-items: center;
}

.control-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 36rpx;
  color: #666;
}

.control-btn:active {
  background: #e8e8e8;
}

.control-value {
  width: 80rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 难度选择器 */
.difficulty-selector {
  display: flex;
  gap: 12rpx;
}

.difficulty-btn {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s;
}

.difficulty-btn.active {
  background: #1890ff;
  color: #ffffff;
}

/* 开始按钮 */
.action-section {
  padding: 20rpx 0;
}

.start-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  border-radius: 50rpx;
  box-shadow: 0 8rpx 30rpx rgba(24, 144, 255, 0.3);
}

.start-btn.disabled {
  background: #cccccc;
  box-shadow: none;
}

.btn-icon {
  font-size: 32rpx;
  color: #ffffff;
  margin-right: 12rpx;
}

.start-btn text:last-child {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
}

.btn-hint {
  display: block;
  text-align: center;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
}
