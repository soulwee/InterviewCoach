/* pages/result/result.wxss */

.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
}

/* 报告头部 */
.report-header {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  color: #ffffff;
}

.header-top {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.report-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.report-title {
  font-size: 40rpx;
  font-weight: bold;
}

.report-date {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.report-position {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
}

/* 概览统计 */
.overview-section {
  margin-bottom: 30rpx;
}

.overview-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.item-ring {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.ring-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #1890ff;
}

.ring-label {
  font-size: 28rpx;
  color: #1890ff;
}

.item-value-large {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.item-value-large .value {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.item-value-large .unit {
  font-size: 26rpx;
  color: #666;
  margin-left: 4rpx;
}

.item-label {
  font-size: 26rpx;
  color: #999;
}

/* 章节卡片 */
.section-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 技能分类 */
.skill-category {
  margin-bottom: 20rpx;
}

.skill-category:last-child {
  margin-bottom: 0;
}

.category-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  color: #1890ff;
  border-radius: 24rpx;
  font-size: 26rpx;
}

/* 题目列表 */
.question-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.question-item {
  border: 1rpx solid #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.question-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fafafa;
}

.question-status {
  margin-right: 16rpx;
}

.status-icon {
  font-size: 32rpx;
}

.status-icon.completed {
  color: #52c41a;
}

.status-icon.pending {
  color: #d9d9d9;
}

.question-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.question-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.question-type {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
}

.expand-icon {
  font-size: 36rpx;
  color: #ccc;
  transition: transform 0.2s;
}

.expand-icon.expanded {
  transform: rotate(90deg);
}

/* 题目详情 */
.question-detail {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background: #ffffff;
}

.question-detail.show {
  max-height: 800rpx;
}

.detail-question {
  display: block;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-answer, .detail-code {
  padding: 20rpx 24rpx;
}

.answer-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.answer-text {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  white-space: pre-wrap;
}

.code-block {
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 20rpx;
  font-family: 'Courier New', monospace;
  font-size: 24rpx;
  color: #333;
  white-space: pre-wrap;
  overflow-x: auto;
}

/* 操作按钮 */
.action-section {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.btn {
  flex: 1;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 45rpx;
  font-size: 30rpx;
}

.btn-outline {
  background: #ffffff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
}

.btn-primary {
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(24, 144, 255, 0.3);
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}
